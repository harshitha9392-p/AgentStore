# ==========================================
# AgentStore: Configuration Environment Variables
# ==========================================

# Application
APP_NAME=AgentStore
APP_ENV=development
DEBUG=true
PORT=8000
SECRET_KEY=supersecretkey-agentstore-buildathon-2026-sha256-production

# Database (PostgreSQL default in Docker; SQLite fallback supported)
DATABASE_URL=postgresql+asyncpg://agentstore:agentstore_pass@localhost:5432/agentstore_db
DATABASE_SYNC_URL=postgresql+psycopg2://agentstore:agentstore_pass@localhost:5432/agentstore_db
# SQLite local fallback (uncomment to use local file without PostgreSQL)
# DATABASE_URL=sqlite+aiosqlite:///./agentstore.db
# DATABASE_SYNC_URL=sqlite:///./agentstore.db

# Redis (Session & Idempotency store)
REDIS_URL=redis://localhost:6379/0

# Razorpay Integration (Test Mode)
RAZORPAY_KEY_ID=rzp_test_buildathon2026mock
RAZORPAY_KEY_SECRET=buildathon_secret_key_mock_9918273645
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_buildathon_mock
RAZORPAY_MOCK_MODE=true

# AI Agent Provider (Built-in deterministic mock agent by default; pluggable Gemini/Claude/OpenAI)
AGENT_PROVIDER=mock
# AGENT_PROVIDER=gemini # (or claude, openai)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Policy Gate Thresholds (Default server-side guardrails)
POLICY_MAX_ORDER_VALUE=50000.00
POLICY_MAX_DISCOUNT_PERCENTAGE=25.0
POLICY_HITL_THRESHOLD=10000.00
POLICY_DAILY_TRANSACTION_LIMIT=100000.00
