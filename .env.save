# ==========================================
# AgentStore: Configuration Environment Variables
# ==========================================

APP_NAME=AgentStore
APP_ENV=development
DEBUG=true
PORT=8000
SECRET_KEY=supersecretkey-agentstore-buildathon-2026-sha256-production

# Database (SQLite for local standalone; PostgreSQL in Docker)
DATABASE_URL=sqlite:///./agentstore.db
DATABASE_SYNC_URL=sqlite:///./agentstore.db

# Redis (In-Memory session manager fallback)
REDIS_URL=redis://localhost:6379/0

# Razorpay Integration (Test Mode)
RAZORPAY_KEY_ID=rzp_test_buildathon2026mock
RAZORPAY_KEY_SECRET=buildathon_secret_key_mock_9918273645
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_buildathon_mock
RAZORPAY_MOCK_MODE=true

# AI Agent Provider ("mock", "gemini", "claude", "openai")
AGENT_PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Server-Side Policy Gate Defaults
POLICY_MAX_ORDER_VALUE=50000.00
POLICY_MAX_DISCOUNT_PERCENTAGE=25.0
POLICY_HITL_THRESHOLD=10000.00
POLICY_DAILY_TRANSACTION_LIMIT=100000.00
RAZORPAY_KEY_ID=rzp_test_TW2VurbtPWrJtZ
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=anyrando
